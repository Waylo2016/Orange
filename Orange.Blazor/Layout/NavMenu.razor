@inject OrangeQuestionApiClient questionApiClient
@inject IConfiguration Configuration

<MudPaper Width="250px" Class="py-3" Elevation="0">
    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="px-4">Orange</MudText>
        <MudDivider Class="my-2"/>
        @foreach(var server in discordServerNames)
        {
            <MudNavGroup 
                Title="@server" 
                Icon="@Icons.Custom.Brands.Discord" 
                Expanded="@Expanded" EnableCollapsedChildNavigation="@EnableCollapsedChildNavigation"
                Class="mud-primary-text"
                >
                
                @foreach (var question in serverQuestions)
                {
                    <MudNavLink>Question @question.Key</MudNavLink>
                }
            </MudNavGroup>
        }
    </MudNavMenu>
</MudPaper>

@code {

    private bool Expanded = true;

    private bool EnableCollapsedChildNavigation = true;

    private Dictionary<int, string?> serverQuestions = new();
    private List<string> discordServerNames = new();
    
    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace this with the actual guild ID from the OAuth flow.
        var questions = await questionApiClient.GetGuildQuestionsAsync(Configuration["Discord:DevGuildId"], CancellationToken.None);
        discordServerNames.Add(questions!.GuildName);
        if (questions.Questions != null)
        {
            serverQuestions.Add(
                questions.Questions
                    .Select(sq => sq.QuestionOrder)
                    .FirstOrDefault(), 
                questions.Questions
                    .Select(sq => sq.Question)
                    .ToString()
                );
        }
    }

}

