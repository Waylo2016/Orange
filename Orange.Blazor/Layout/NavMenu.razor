@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<FluentStack Orientation="Orientation.Horizontal" Width="100%">
    <FluentNavMenu @bind-Expanded="Expanded"
                   Width="250"
                   Collapsible="true"
                   Title="Discord servers">
        @foreach (var discordServer in DiscordServers)
        {
            <FluentNavGroup Icon="@(new Icons.Regular.Size20.Server())", Title="@discordServer" Collapsible="true" EnableCollapsedChildNavigation="@EnableCollapsedChildNavigation">
                @for (int i = 0; i < submenuCounts[discordServer]; i++)
                {
                    var localvar = i; // capture loop var
                    <FluentNavLink>Question @localvar</FluentNavLink>
                }
            </FluentNavGroup>
        }
    </FluentNavMenu>
</FluentStack>

@code {

    private bool Expanded = true;

    private bool EnableCollapsedChildNavigation = true;

    private readonly List<string> DiscordServers =
    [
        "Server 1",
        "Server 2",
        "Server 3"
    ];

    private Dictionary<string, int> submenuCounts = new();

    protected override void OnInitialized()
    {
        foreach (var server in DiscordServers)
        {
            submenuCounts[server] = Random.Shared.Next(1, 11); // 1 t/m 10
        }
    }

}

