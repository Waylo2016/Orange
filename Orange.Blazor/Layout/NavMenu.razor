<MudPaper Width="250px" Class="py-3" Elevation="0">
    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="px-4">Orange</MudText>
        <MudDivider Class="my-2"/>
        @foreach(var server in DiscordServers)
        {
            <MudNavGroup 
                Title="@server" 
                Icon="@Icons.Custom.Brands.Discord" 
                Expanded="@Expanded" EnableCollapsedChildNavigation="@EnableCollapsedChildNavigation"
                Class="mud-primary-text"
                >
               
                @for (int i = 1; i <= submenuCounts[server]; i++)
                {
                    var localI = i;
                    <MudNavLink Href="#">Question @localI</MudNavLink>
                }
            </MudNavGroup>
        }
    </MudNavMenu>
</MudPaper>

@code {

    private bool Expanded = true;

    private bool EnableCollapsedChildNavigation = true;

    private readonly List<string> DiscordServers =
    [
        "Server 1",
        "Server 2",
        "Server 3"
    ];

    private Dictionary<string, int> submenuCounts = new();

    protected override void OnInitialized()
    {
        foreach (var server in DiscordServers)
        {
            submenuCounts[server] = Random.Shared.Next(1, 11); // 1 t/m 10
        }
    }

}

