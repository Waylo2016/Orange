@inject OrangeQuestionApiClient questionApiClient
@inject IConfiguration Configuration

<MudPaper Width="250px" Class="py-3" Elevation="0">
    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="px-4">Orange</MudText>
        <MudDivider Class="my-2"/>
        @foreach(var server in _discordServerNames)
        {
            <MudNavGroup 
                Title="@server" 
                Icon="@Icons.Custom.Brands.Discord" 
                Expanded="@_expanded" enableCollapsedChildNavigation="@_enableCollapsedChildNavigation"
                Class="mud-primary-text"
                >
                
                @foreach (var question in _serverQuestions)
                {
                    <MudNavLink>Question @question.Key</MudNavLink>
                }
            </MudNavGroup>
        }
    </MudNavMenu>
</MudPaper>

@code {

    private readonly bool _expanded = true;

    private readonly bool _enableCollapsedChildNavigation = true;

    private readonly Dictionary<int, string?> _serverQuestions = new();
    private readonly List<string> _discordServerNames = [];
    
    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace this with the actual guild ID from the OAuth flow.
        var questions = await questionApiClient.GetGuildQuestionsAsync(Configuration["Discord:DevGuildId"]!, CancellationToken.None);
        _discordServerNames.Add(questions!.GuildName);
        if (questions.Questions != null)
        {
            _serverQuestions.Add(
                questions.Questions
                    .Select(sq => sq.QuestionOrder)
                    .FirstOrDefault(), 
                questions.Questions
                    .Select(sq => sq.Question)
                    .ToString()
                );
        }
    }

}

